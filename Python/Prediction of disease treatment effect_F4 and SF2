### Prediction of disease treatment effect

# libraries
import pandas as pd
import numpy as np
import networkx as nx
import warnings
import seaborn as sns
import matplotlib.pyplot as plt

# data
data = pd.read_csv(".../Clean Data_Random Forest_V1.csv")

# set a white background  
sns.set(style="whitegrid")

### Results: Figure 4 and Supplemental Figure 2 in Paper
# prediction variable: Annual costs
# prediction1 variable: Active constituents

# Susceptibility to R6 Strains
sns.set(style="white")
plt.figure(figsize=(10,8))
ax= sns.violinplot(x='Susceptibility_to_R6_Strains', y='predictions', data=data)
ax.set_xlabel("Susceptibility to V6 strains", fontsize=16)
ax.set_ylabel("Prediction of disease treatment effect", fontsize=20)
plt.tick_params(axis='both', labelsize=20)
plt.savefig("1.png", dpi=1000)


