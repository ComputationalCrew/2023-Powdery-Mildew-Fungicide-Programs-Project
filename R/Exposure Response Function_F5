### Exposure Response Function
### Figure 5: Covariate balance plot

# Package
library("CausalGPS")
library(ggplot2)

# Data
df <- read.csv(".../Clean Data_Random Forest_V1.csv")

df$Quadrant <- as.factor(df$Quadrant)
df$Grower_Ordinal <- as.factor(df$Grower_Ordinal)
df$Year <- as.factor(df$Year)
df$id <- seq.int(nrow(df))
summary(df)
colnames(df)

# Estimate T hat

reg1 <- glm(df$Mildew_Incidence~df$Mildew_May+df$Susceptibility_to_R6_Strains+df$Susceptibility_to_nonR6_Strains+df$Initial_strain+df$Pruning+df$Quadrant+df$Grower_Ordinal+df$Year)
summary(reg1)
df$T.hat <- predict(reg1)

# Generating pseudo population 

pseudo_pop <- generate_pseudo_pop(
  df[, c("id", "T.hat")],
  df[, c("id", "Susceptibility_to_R6_Strains" , "Susceptibility_to_nonR6_Strains", "Initial_strain", "Pruning", "Quadrant", "Grower_Ordinal", "Year", "Mildew_May")],
  ci_appr = "weighting",
  gps_density = "kernel",
  use_cov_transform = TRUE,
  transformers = list("pow2", "pow3", "abs", 
                      "scale"),
  exposure_trim_qtls = c(0.01,0.99),
  sl_lib = c("m_xgboost"),
  covar_bl_method = "absolute",
  covar_bl_trs = 0.2,
  covar_bl_trs_type = "mean",
  max_attempt = 4,
  dist_measure = "l1",
  delta_n = 0.02,          # changed from 1 to 0.02
  scale = 0.5,
  nthread = 1
  )                            

### Figure 5: Covariate balance plot
png("pseudo_pop.png", width=6000,height=7000, res=1000)
plot(pseudo_pop) + theme(panel.grid.major = element_blank(), panel.grid.minor = element_blank(),
                                                 panel.background = element_blank(), axis.line = element_line(colour = "black")) 

dev.off()

# Estimating GPS
data_with_gps <- estimate_gps(w = pseudo_pop$pseudo_pop[, c("id", "T.hat")],
                              c = pseudo_pop$pseudo_pop[, c("id", "Susceptibility_to_R6_Strains" , "Susceptibility_to_nonR6_Strains", "Initial_strain", "Pruning", "Quadrant", "Grower_Ordinal", "Year", "Mildew_May")],
                              params = list(xgb_max_depth = c(3,4,5),
                                            xgb_rounds = c(10,20,30,40)),
                              nthread = 1,                                
                              sl_lib = c("m_xgboost")
                              )
data_with_gps[["dataset"]][["gps"]]
